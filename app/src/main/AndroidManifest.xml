<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:targetSandboxVersion="1">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".MyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.GraduationProject"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".messaging.ChatMainActivity2"
            android:exported="false" />
        <activity
            android:name=".messaging.ChatWindowActivity2"
            android:exported="false" />
        <activity
            android:name=".ui.parentUi.ParentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".messaging.ChatMainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".messaging.ChatWindowActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".messaging.SettingMessagingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".broadcastReceiver.BroadcastHandler"
            android:exported="false"
            android:permission="TODO">
            <intent-filter>
                <action android:name="UPDATE_TEACHER_UI" />
                <action android:name="SHOW_RECEIVED_REQUESTS_FOR_PARENT" />
                <action android:name="UPDATE_NOTIFICATIONS_RECYCLER_VIEW" />
                <action android:name="SHOW_TEACHER_POSTED_REQUESTS_FOR_PARENT" />
                <action android:name="UPDATE_POSTED_DATA_FOR_PARENT" />
                <action android:name="NOTIFY_PARENT_FRAGMENT_NEW_TEACHER_MATCH_MODEL_ADDED" />
                <action android:name="SHOW_RECEIVED_REQUESTS_FOR_PARENT" />
                <action android:name="SHOW_DELETE_COURSE_REQUEST_FOR_PARENT" />
                <action android:name="SHOW_DECLINED_DELETE_COURSE_FOR_PARENT" />
                <action android:name="SHOW_TEACHER_RECEIVED_REQUESTS" />
                <action android:name="SHOW_PARENT_POSTED_REQUESTS_FOR_TEACHER" />
                <action android:name="UPDATE_TEACHER_POSTED_REQUESTS" />
                <action android:name="SHOW_TEACHER_RECEIVED_REQUESTS" />
                <action android:name="SHOW_DELETE_COURSE_REQUEST_FOR_TEACHER" />
                <action android:name="SHOW_DELETE_DECLINED_COURSE_REQUEST_FOR_TEACHER" />
            </intent-filter>
        </receiver>

        <service android:name=".backgroundActions.NotificationsService" />

        <activity
            android:name=".ui.teacherUi.TeacherActivity"
            android:exported="true" />
        <activity
            android:name=".ui.register.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.login.IntroActivity"
            android:exported="true" />
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>