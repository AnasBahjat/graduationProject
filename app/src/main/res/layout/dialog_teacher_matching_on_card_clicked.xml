<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/custom_dialog_rounded_corners"
    android:padding="16dp">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/closeImageView"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"

            android:layout_marginTop="4dp"
            android:src="@drawable/close_icon_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/profileImageView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/user"
            app:layout_constraintDimensionRatio="H,90:125"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/closeImageView"
            app:layout_constraintWidth_percent="0.22" />

        <TextView
            android:id="@+id/parentNameTextViewTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:text="Parent Name : "
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@+id/parentPhoneNumberTextViewTemp"
            app:layout_constraintStart_toEndOf="@+id/profileImageView"
            app:layout_constraintTop_toTopOf="@+id/profileImageView" />

        <TextView
            android:id="@+id/parentNameTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1A8E9E"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/parentNameTextViewTemp"
            app:layout_constraintTop_toTopOf="@+id/parentNameTextViewTemp" />

        <TextView
            android:id="@+id/parentPhoneNumberTextViewTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:text="Parent Phone : "
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@+id/profileImageView"
            app:layout_constraintTop_toBottomOf="@+id/parentNameTextViewTemp" />

        <TextView
            android:id="@+id/parentPhoneNumberTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1A8E9E"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/parentPhoneNumberTextViewTemp"
            app:layout_constraintTop_toBottomOf="@+id/parentNameTextView" />

        <TextView
            android:id="@+id/parentEmailTextViewTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_toEndOf="@id/profileImageView"
            android:text="Parent Email : "
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@+id/profileImageView"
            app:layout_constraintTop_toBottomOf="@+id/parentPhoneNumberTextView" />

        <TextView
            android:id="@+id/parentEmailTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_toEndOf="@+id/parentNameTextViewTemp"
            android:textColor="#1A8E9E"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/parentEmailTextViewTemp"
            app:layout_constraintTop_toBottomOf="@+id/parentPhoneNumberTextView" />

        <LinearLayout
            android:id="@+id/tempView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/parentEmailTextView"
            android:layout_marginTop="45dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/parentEmailTextView">

            <View
                android:id="@+id/childInformationTempView"
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_gravity="center"
                android:layout_marginStart="6dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="1dp"
                android:background="#7FE1EE" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="5dp"
                android:text="Child Information"
                android:textSize="22sp" />


            <View
                android:layout_width="230dp"
                android:layout_height="2dp"
                android:layout_gravity="center"
                android:layout_marginStart="7dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="15dp"
                android:background="#7FE1EE" />
        </LinearLayout>

        <ImageView
            android:id="@+id/childNameImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_below="@id/tempView3"
            android:layout_alignParentStart="true"

            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/profile_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tempView3" />


        <TextView
            android:id="@+id/childNameTextViewTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tempView3"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:layout_toEndOf="@id/childNameImageView"
            android:text="Child Name : "
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@+id/childNameImageView"
            app:layout_constraintTop_toBottomOf="@+id/tempView3" />

        <TextView
            android:id="@+id/childNameTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/tempView3"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="5dp"
            android:layout_toEndOf="@id/childNameTextViewTemp"
            android:textColor="#1A8E9E"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/childNameTextViewTemp"
            app:layout_constraintTop_toBottomOf="@+id/tempView3" />

        <ImageView
            android:id="@+id/childGradeImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_below="@id/childNameTextView"
            android:layout_alignParentStart="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/grades_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/childNameTextView" />

        <TextView
            android:id="@+id/childGradeTextViewTemp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/childNameTextView"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:layout_toEndOf="@id/childGradeImageView"
            android:text="Child Grade : "

            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@+id/childGradeImageView"
            app:layout_constraintTop_toBottomOf="@+id/childNameTextView" />

        <TextView
            android:id="@+id/childGradeTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/childNameTextView"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"

            android:layout_marginEnd="5dp"
            android:layout_toEndOf="@id/childGradeTextViewTemp"
            android:textColor="#1A8E9E"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/childGradeTextViewTemp"
            app:layout_constraintTop_toBottomOf="@+id/childNameTextView" />

        <ImageView
            android:id="@+id/childGenderImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_below="@id/childGradeTextView"
            android:layout_alignParentStart="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"

            android:src="@drawable/gender_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/childGradeTextView" />

        <TextView
            android:id="@+id/childGenderTextViewTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/childGradeTextView"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"

            android:layout_toEndOf="@id/childGenderImageView"
            android:text="Child Gender : "
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@+id/childGenderImageView"
            app:layout_constraintTop_toBottomOf="@+id/childGradeTextView" />

        <TextView
            android:id="@+id/childGenderTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/childGradeTextView"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="5dp"

            android:layout_marginTop="15dp"
            android:layout_marginEnd="5dp"
            android:layout_toEndOf="@id/childGenderTextViewTemp"
            android:textColor="#1A8E9E"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/childGenderTextViewTemp"
            app:layout_constraintTop_toBottomOf="@+id/childGradeTextView" />

        <ImageView
            android:id="@+id/childAgeImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_below="@id/childGenderTextView"
            android:layout_alignParentStart="true"

            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/teacher_age_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/childGenderTextView" />

        <TextView
            android:id="@+id/childAgeTextViewTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/childGenderTextView"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:layout_toEndOf="@id/childAgeImageView"
            android:text="Child Age : "
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@+id/childAgeImageView"
            app:layout_constraintTop_toBottomOf="@+id/childGenderTextView" />

        <TextView
            android:id="@+id/childAgeTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/childGenderTextView"
            android:layout_alignParentEnd="true"

            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:layout_toEndOf="@id/childAgeTextViewTemp"
            android:textColor="#1A8E9E"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/childAgeTextViewTemp"
            app:layout_constraintTop_toBottomOf="@+id/childGenderTextView" />

        <LinearLayout
            android:id="@+id/tempView1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/childAgeTextView"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/childAgeTextView">

            <View
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_gravity="center"
                android:layout_marginStart="6dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="1dp"
                android:background="#7FE1EE" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="5dp"
                android:text="Teaching Information"
                android:textSize="22sp" />


            <View
                android:layout_width="190dp"
                android:layout_height="2dp"
                android:layout_gravity="center"
                android:layout_marginStart="7dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="15dp"
                android:background="#7FE1EE" />
        </LinearLayout>

        <ImageView
            android:id="@+id/coursesImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_below="@id/tempView1"
            android:layout_alignParentStart="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/courses_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tempView1" />

        <TextView
            android:id="@+id/coursesTextViewTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tempView1"
            android:layout_marginStart="5dp"
            android:layout_marginTop="20dp"
            android:layout_toEndOf="@id/coursesImageView"
            android:text="Courses : "
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@+id/coursesImageView"
            app:layout_constraintTop_toBottomOf="@+id/tempView1" />

        <TextView
            android:id="@+id/coursesTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/tempView1"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="5dp"
            android:layout_toEndOf="@id/coursesTextViewTemp"
            android:textColor="#1A8E9E"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/coursesTextViewTemp"
            app:layout_constraintTop_toBottomOf="@+id/tempView1" />

        <ImageView
            android:id="@+id/choseDaysImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_below="@id/coursesTextView"
            android:layout_alignParentStart="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"

            android:src="@drawable/days_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/coursesTextView" />

        <TextView
            android:id="@+id/choseDaysTextViewTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/coursesTextView"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"

            android:layout_toEndOf="@id/coursesImageView"
            android:text="Days : "
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@+id/choseDaysImageView"
            app:layout_constraintTop_toBottomOf="@+id/coursesTextView" />

        <TextView
            android:id="@+id/choseDaysTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/coursesTextView"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:layout_toEndOf="@id/choseDaysTextViewTemp"
            android:textColor="#1A8E9E"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/choseDaysTextViewTemp"
            app:layout_constraintTop_toBottomOf="@+id/coursesTextView" />

        <ImageView
            android:id="@+id/timeImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_below="@id/dateTextView"
            android:layout_alignParentStart="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"

            android:src="@drawable/clock_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/choseDaysTextView" />

        <TextView
            android:id="@+id/timeMethodTextViewTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/dateTextView"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"

            android:layout_toEndOf="@id/timeImageView"
            android:text="Time : "
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@+id/timeImageView"
            app:layout_constraintTop_toBottomOf="@+id/choseDaysTextView" />

        <TextView
            android:id="@+id/timeTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="5dp"

            android:layout_marginTop="15dp"
            android:layout_toEndOf="@id/timeMethodTextViewTemp"
            android:textColor="#1A8E9E"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/timeMethodTextViewTemp"
            app:layout_constraintTop_toBottomOf="@+id/choseDaysTextView" />

        <ImageView
            android:id="@+id/dateImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_below="@id/choseDaysTextView"
            android:layout_alignParentStart="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"

            android:src="@drawable/calendar_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/timeTextView" />

        <TextView
            android:id="@+id/dateTextViewTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/choseDaysTextView"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:layout_toEndOf="@id/dateImageView"

            android:text="Date  : "
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@+id/dateImageView"
            app:layout_constraintTop_toBottomOf="@+id/timeTextView" />

        <TextView
            android:id="@+id/dateTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/choseDaysTextView"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:layout_toEndOf="@id/dateTextViewTemp"

            android:textColor="#1A8E9E"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/dateTextViewTemp"
            app:layout_constraintTop_toBottomOf="@+id/timeTextView" />

        <ImageView
            android:id="@+id/teachingMethodImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_below="@id/timeTextView"
            android:layout_alignParentStart="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/teaching_method_icon_2"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dateTextView" />

        <TextView
            android:id="@+id/teachingMethodViewTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/timeTextView"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:layout_toEndOf="@id/teachingMethodImageView"
            android:text="Teaching Method : "

            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@+id/teachingMethodImageView"
            app:layout_constraintTop_toBottomOf="@+id/dateTextView" />

        <TextView
            android:id="@+id/teachingMethodTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/timeTextView"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:layout_toEndOf="@id/teachingMethodViewTemp"
            android:textColor="#1A8E9E"

            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/teachingMethodViewTemp"
            app:layout_constraintTop_toBottomOf="@+id/dateTextView" />

        <ImageView
            android:id="@+id/locationImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_below="@id/teachingMethodTextView"
            android:layout_alignParentStart="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/location_icon"
            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintTop_toBottomOf="@+id/teachingMethodTextView" />

        <TextView
            android:id="@+id/locationTextViewTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/teachingMethodTextView"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:layout_toEndOf="@id/locationImageView"
            android:text="Location : "
            android:textSize="16sp"

            app:layout_constraintStart_toEndOf="@+id/locationImageView"
            app:layout_constraintTop_toBottomOf="@+id/teachingMethodTextView" />

        <TextView
            android:id="@+id/locationTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/teachingMethodTextView"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:layout_toEndOf="@id/locationTextViewTemp"
            android:textColor="#1A8E9E"

            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/locationTextViewTemp"
            app:layout_constraintTop_toBottomOf="@+id/teachingMethodTextView" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/sendRequestBtn"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_below="@id/locationTextView"
            android:layout_marginTop="20dp"

            android:layout_toStartOf="@id/sendMessageToParentBtn"
            android:background="@drawable/rounded_corners"
            android:backgroundTint="@color/usedColor"
            android:text="Send Request"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:paddingStart="9dp"
            android:layout_marginBottom="20dp"
            android:layout_marginEnd="5dp"
            android:paddingEnd="9dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/sendMessageToParentBtn"
            app:layout_constraintTop_toBottomOf="@+id/locationTextView" />

        <LinearLayout
            android:id="@+id/requestSentView"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_below="@id/locationTextView"
            android:layout_marginEnd="5dp"
            android:visibility="gone"
            android:layout_marginTop="20dp"
            android:background="@drawable/rounded_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="10dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/sendMessageToParentBtn"
            app:layout_constraintTop_toBottomOf="@+id/locationTextView">

            <ImageView
                android:id="@+id/requestSentImageView"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/check_icon" />

            <TextView
                android:id="@+id/requestSentTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Request Sent"
                android:textColor="@android:color/black"
                android:textSize="16sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/sendMessageToParentBtn"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/rounded_corners"
            android:backgroundTint="@color/usedColor"
