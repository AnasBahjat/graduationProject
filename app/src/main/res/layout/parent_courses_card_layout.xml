<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parentCourseCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="30dp"
    android:layout_marginBottom="2dp"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp"
    app:cardElevation="5dp"
    android:backgroundTint="#E4ECEC"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/profileImage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/user"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/dateLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/profileImage"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/dateImageView"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/calendar_icon" />

            <TextView
                android:id="@+id/dateTextViewTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Date :"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dateTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="12dp"
                android:textColor="#1A8E9E"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/timeLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/profileImage"
            app:layout_constraintTop_toBottomOf="@+id/dateLayout">

            <ImageView
                android:id="@+id/timeImageView"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/clock_icon" />

            <TextView
                android:id="@+id/timeTextViewTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Time :"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/timeTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/dateTextView"
                android:layout_marginStart="7dp"

                android:layout_marginEnd="12dp"
                android:layout_toEndOf="@id/dateTextViewTemp"
                android:textColor="#1A8E9E"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/daysLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/profileImage"
            app:layout_constraintTop_toBottomOf="@+id/timeLayout">

            <ImageView
                android:id="@+id/daysImageView"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/days_icon" />

            <TextView
                android:id="@+id/daysTextViewTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Days :"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/daysTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="12dp"
                android:textColor="#1A8E9E"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tempView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/daysLayout">

            <View
                android:id="@+id/childInformationTempView"
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_gravity="center"
                android:layout_marginStart="6dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="1dp"
                android:background="#7FE1EE" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="5dp"
                android:text="Course Information"
                android:textSize="18sp" />

            <View
                android:layout_width="200dp"
                android:layout_height="2dp"
                android:layout_gravity="center"
                android:layout_marginStart="7dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="15dp"
                android:background="#7FE1EE" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/objectsLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tempView3">

            <ImageView
                android:id="@+id/coursesImageView"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/courses_icon"
                android:layout_marginStart="5dp" />

            <TextView
                android:id="@+id/coursesTextViewTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Objects :"
                android:textSize="13sp"
                android:layout_marginStart="8dp"/>

            <TextView
                android:id="@+id/coursesTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textColor="#1A8E9E"
                android:layout_marginStart="7dp"
                android:textSize="13sp"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/childNameLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/objectsLayout">

            <ImageView
                android:id="@+id/childNameImageView"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/days_icon"
                android:layout_marginStart="5dp"
                />

            <TextView
                android:id="@+id/childNameTextViewTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Child Name :"
                android:textSize="13sp"
                android:layout_marginStart="8dp"/>

            <TextView
                android:id="@+id/childNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textColor="#1A8E9E"
                android:layout_marginStart="7dp"
                android:textSize="13sp"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/teacherNameLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/childNameLayout">

            <ImageView
                android:id="@+id/teacherNameImageView"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/age_icon_2"
                android:layout_marginStart="5dp" />

            <TextView
                android:id="@+id/teacherNameTextViewTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Teacher Name :"
                android:textSize="13sp"
                android:layout_marginStart="8dp"/>

            <TextView
                android:id="@+id/teacherNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textColor="#1A8E9E"
                android:layout_marginStart="7dp"
                android:textSize="13sp"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/teachingMethodLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/teacherNameLayout">

            <ImageView
                android:id="@+id/teachingMethodImageView"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/teaching_method_icon_2"
                android:layout_marginStart="5dp" />

            <TextView
                android:id="@+id/teachingMethodTextViewTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Teaching Method:"
                android:textSize="13sp"
                android:layout_marginStart="8dp"/>

            <TextView
                android:id="@+id/teachingMethodTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textColor="#1A8E9E"
                android:layout_marginStart="7dp"
                android:textSize="13sp"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/moreDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="13dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/teachingMethodLayout">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="-2dp"
                android:layout_marginEnd="-5dp"
                android:text="More details"
                android:textSize="14sp"

                />

            <ImageView
                android:id="@+id/arrowImageView"
                android:layout_width="55dp"
                android:layout_height="30dp"
                android:src="@drawable/right_arrow_icon" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>