<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/usedColor"
    tools:context=".messaging.SettingMessagingActivity">

    <ImageView
        android:id="@+id/settingprofile"
        android:layout_width="179dp"
        android:layout_height="149dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="50dp"
        app:srcCompat="@drawable/photocamera" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/newName"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="32dp"
        android:hint="New Alias"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/settingprofile"
        app:endIconMode="clear_text"
        app:errorEnabled="true"
        app:errorIconDrawable="@drawable/baseline_error_24"
        app:errorTextAppearance="@style/error_text"
        app:hintTextAppearance="@style/CustomHintTextAppearance"
        app:startIconDrawable="@drawable/firstname_icon">

        <EditText
            android:id="@+id/settingname"

            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:background="@drawable/edit_text_style"
            android:textSize="20sp" />
    </com.google.android.material.textfield.TextInputLayout>


    <Button
        android:id="@+id/donebutt"
        android:backgroundTint="@color/black"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_35sdp"
        android:text="Save"
        android:layout_marginTop="30dp"
        app:cornerRadius="25dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/newName"/>

</RelativeLayout>