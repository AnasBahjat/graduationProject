<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="13.00dp"
    android:background="@drawable/bordermain">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/userimg"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:src="@drawable/photocamera"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"/>

    <TextView
        android:id="@+id/username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@+id/numOfUnreadMessages"
        android:layout_toEndOf="@id/userimg"
        android:fontFamily="@font/poppins_bold"
        android:text="Name"
        android:textColor="@color/black"
        android:textSize="23.40dp" />

    <TextView
        android:id="@+id/userstatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/username"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@+id/numOfUnreadMessages"
        android:layout_toEndOf="@id/userimg"
        android:fontFamily="@font/poppins_regular"
        android:text="Status"
        android:textColor="@color/black"
        android:textSize="10.40dp" />

    <TextView
        android:id="@+id/numOfUnreadMessages"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="10dp"
        android:layout_centerVertical="true"
        android:textAlignment="center"
        android:gravity="center"
        android:textSize="23sp"
        android:visibility="gone"
        android:padding="10dp"
        android:background="@drawable/custom_text_view_for_notification"
        android:textColor="@color/white" />

</RelativeLayout>